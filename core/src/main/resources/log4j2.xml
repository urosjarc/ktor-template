<?xml version="1.0" encoding="UTF-8"?>
<Configuration scan="true">

    <Appenders>

        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy.MM.dd HH:mm:ss.SSS} | %70c:%-3line | %-5level | reqId=%.8X{requestId},userId=%.8X{userId} | %msg%n"/>
        </Console>

        <JDBC name="Database" tableName="system.logs_application" bufferSize="10" ignoreExceptions="true">
            <PoolingDriver connectionString="jdbc:${env:DB_TYPE}://${env:DB_DOMAIN}:${env:DB_PORT}/${env:DB_NAME}"
                           userName="${env:DB_USER}"
                           password="${env:DB_PASSWORD}" poolName="LogDatabase"/> <!-- UUID -->
            <ColumnMapping name="timestamp" pattern="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX}" columnType="java.sql.Timestamp"/>
            <ColumnMapping name="level" pattern="%level"/>
            <ColumnMapping name="marker" pattern="%marker"/>
            <ColumnMapping name="logger" pattern="%logger"/>
            <ColumnMapping name="line" pattern="%line"/>
            <ColumnMapping name="message" pattern="%message"/>
            <ColumnMapping name="thread" pattern="%thread"/>
            <ColumnMapping name="request_id" pattern="%X{requestId}"/>
            <ColumnMapping name="user_id" pattern="%X{userId}"/>
            <ColumnMapping name="exception" pattern="%throwable"/>
        </JDBC>

        <RollingRandomAccessFile name="File-trace"
                                 append="true"
                                 fileName="logs/trace/current.log"
                                 filePattern="logs/trace/$${date:yyyy-MM}/%d{yyyy-dd-MMMM-dd}.log.zip"
                                 bufferedIO="true"
                                 immediateFlush="false">
            <PatternLayout pattern="%d{yyyy.MM.dd HH:mm:ss.SSS} %40c:%-3line | %-5level | %msg%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
            </Policies>
            <DefaultRolloverStrategy max="14"/>
        </RollingRandomAccessFile>

        <RollingRandomAccessFile name="File-info"
                                 append="true"
                                 fileName="logs/info/current.log"
                                 filePattern="logs/info/$${date:yyyy-MM}/%d{yyyy-dd-MMMM-dd}.log.zip"
                                 bufferedIO="true"
                                 immediateFlush="false">
            <PatternLayout pattern="%d{yyyy.MM.dd HH:mm:ss.SSS} %40c:%-3line | %-5level | %msg%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
            </Policies>
            <DefaultRolloverStrategy max="14"/>
        </RollingRandomAccessFile>

        <RollingRandomAccessFile name="File-warn"
                                 append="true"
                                 fileName="logs/warn/current.log"
                                 filePattern="logs/warn/$${date:yyyy-MM}/%d{yyyy-dd-MMMM-dd}.log.zip"
                                 bufferedIO="true"
                                 immediateFlush="false">
            <PatternLayout pattern="%d{yyyy.MM.dd HH:mm:ss.SSS} %40c:%-3line | %-5level | %msg%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
            </Policies>
            <DefaultRolloverStrategy max="14"/>
        </RollingRandomAccessFile>

        <RollingRandomAccessFile name="File-error"
                                 append="true"
                                 fileName="logs/error/current.log"
                                 filePattern="logs/error/$${date:yyyy-MM}/%d{yyyy-dd-MMMM-dd}.log.zip"
                                 bufferedIO="true"
                                 immediateFlush="false">
            <PatternLayout pattern="%d{yyyy.MM.dd HH:mm:ss.SSS} %40c:%-3line | %-5level | %msg%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
            </Policies>
            <DefaultRolloverStrategy max="14"/>
        </RollingRandomAccessFile>

        <Async name="Async-Console"
               ignoreExceptions="false"
               includeLocation="true">
            <AppenderRef ref="Console"/>
        </Async>
        <Async name="Async-Database"
               includeLocation="true"
               ignoreExceptions="true">
            <AppenderRef ref="Database"/>
        </Async>
        <Async name="Async-File-trace"
               includeLocation="true">
            <AppenderRef ref="File-trace"/>
        </Async>
        <Async name="Async-File-info"
               includeLocation="true">
            <AppenderRef ref="File-info"/>
        </Async>
        <Async name="Async-File-warn"
               includeLocation="true">
            <AppenderRef ref="File-warn"/>
        </Async>
        <Async name="Async-File-error"
               includeLocation="true">
            <AppenderRef ref="File-error"/>
        </Async>

    </Appenders>

    <Loggers>
        <Root includeLocation="true" level="TRACE">
            <AppenderRef level="trace" ref="Async-Console"/>
            <AppenderRef level="trace" ref="Async-Database"/>
            <AppenderRef level="trace" ref="Async-File-trace"/>
            <AppenderRef level="info" ref="Async-File-info"/>
            <AppenderRef level="warn" ref="Async-File-warn"/>
            <AppenderRef level="error" ref="Async-File-error"/>
        </Root>
        <Logger name="io.netty" level="INFO"/>
        <Logger name="io.r2dbc" level="INFO"/>
        <Logger name="reactor.netty" level="INFO"/>
        <Logger name="reactor.pool" level="INFO"/>
    </Loggers>
</Configuration>
